{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "sourceMap": true,
    "inlineSourceMap": false,
    "inlineSources": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@helium/blockchain-api": [
        "../blockchain-api-client/src/index.ts"
      ],
      "@helium/blockchain-api/*": [
        "../blockchain-api-client/src/*"
      ]
    }
  },
  "include": [
    "**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
