    "@solana/web3.js": "^1.99.0",
    "@sqds/multisig": "^2.1.4",
    "@types/bn.js": "^5.2.0",
    "@types/node-cron": "^3.0.11",
    "angry-purple-tiger": "^1.0.5",
    "aws-sdk": "^2.1692.0",
    "axios": "^1.10.0",
    "bn.js": "^5.2.2",
    "fastify": "^5.12.5",
    "h3-js": "^4.4.0",
