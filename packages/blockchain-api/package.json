{
  "name": "@helium/blockchain-api-service",
  "private": true,
  "version": "0.12.2",
  "description": "Helium Blockchain API - Web application for Helium blockchain",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/helium/helium-program-library.git",
    "directory": "packages/blockchain-api"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names next,bg-svc --prefix-colors blue,green \"pnpm run dev:next-only\" \"pnpm run background-service\"",
    "dev:next-only": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "format:fix": "prettier --check --write \"src/**/*.{js,ts,tsx}\"",
    "lint": "pnpm run format:fix && eslint src/",
    "lint:check": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "background-service": "node scripts/start-background-service.js",
    "test:e2e": "NODE_OPTIONS='--max-old-space-size=8192' DOTENV_CONFIG_PATH=.env.test mocha -r dotenv/config -r @swc-node/register \"tests/e2e/**/*.test.ts\" --timeout 100000",
    "test:e2e:file": "NODE_OPTIONS='--max-old-space-size=8192' DOTENV_CONFIG_PATH=.env.test mocha -r dotenv/config -r @swc-node/register --timeout 100000",
    "test:unit": "mocha -r @swc-node/register \"tests/unit/**/*.test.ts\" --timeout 10000",
    "sequelize-cli": "sequelize-cli"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.1",
    "@helium/account-fetch-cache": "workspace:^",
    "@helium/blockchain-api": "workspace:^",
    "@helium/circuit-breaker-sdk": "workspace:^",
    "@helium/cron-sdk": "^0.1.1",
    "@helium/data-credits-sdk": "workspace:^",
    "@helium/distributor-oracle": "workspace:^",
    "@helium/helium-entity-manager-sdk": "workspace:^",
    "@helium/helium-sub-daos-sdk": "workspace:^",
    "@helium/hpl-crons-sdk": "workspace:^",
    "@helium/idls": "workspace:^",
    "@helium/lazy-distributor-sdk": "workspace:^",
    "@helium/mini-fanout-sdk": "workspace:^",
    "@helium/onboarding": "^5.0.4",
    "@helium/spl-utils": "workspace:^",
    "@helium/sus": "workspace:^",
    "@helium/tuktuk-idls": "^0.1.1",
    "@helium/tuktuk-sdk": "^0.1.1",
    "@helium/voter-stake-registry-sdk": "workspace:^",
    "@helium/welcome-pack-sdk": "workspace:^",
    "@metaplex-foundation/mpl-bubblegum": "0.7.0",
    "@metaplex-foundation/mpl-token-metadata": "2.10.0",
    "@orpc/client": "1.13.6",
    "@orpc/contract": "1.13.6",
    "@orpc/json-schema": "1.13.6",
    "@orpc/openapi": "1.13.6",
    "@orpc/server": "1.13.6",
    "@orpc/zod": "1.13.6",
    "@privy-io/server-auth": "^1.28.8",
    "@sentry/nextjs": "^10",
    "@solana/spl-token": "^0.4.13",
    "@solana/web3.js": "^1.99.0",
    "@sqds/multisig": "^2.1.4",
    "@t3-oss/env-nextjs": "^0.13.8",
    "@types/bn.js": "^5.2.0",
    "@types/node-cron": "^3.0.11",
    "angry-purple-tiger": "^1.0.5",
    "aws-sdk": "^2.1692.0",
    "axios": "^1.10.0",
    "bn.js": "^5.2.2",
    "h3-js": "^4.4.0",
    "jito-ts": "^4.2.0",
    "js-sha256": "^0.11.1",
    "next": "^15.5.18",
    "node-cron": "^4.2.1",
    "pg": "^8.16.2",
    "pg-hstore": "^2.3.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "sequelize": "^6.37.7",
    "uuid": "^11.1.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@swc-node/register": "^1.11.1",
    "@swc/core": "^1.13.5",
    "@swc/register": "^0.1.10",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24",
    "@types/pg": "^8.15.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "chai": "^6.2.0",
    "concurrently": "^9.1.2",
    "dotenv": "^17.2.2",
    "eslint": "^9",
    "eslint-config-next": "15.4.6",
    "mocha": "^11.7.5",
    "prettier": "^3.7.4",
    "sequelize-cli": "^6.6.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "why-is-node-running": "^3.2.2",
    "yaml": "^2.8.1"
  },
  "optionalDependencies": {
    "sqlite3": "^5.1.7"
  },
  "resolutions": {
    "@solana/web3.js": "1.99.0"
  }
}
