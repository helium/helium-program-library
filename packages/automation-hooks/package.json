{
  "name": "@helium/automation-hooks",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "Apache-2.0",
  "version": "0.14.0",
  "description": "React hooks for helium automation",
  "repository": {
    "type": "git",
    "url": "https://github.com/helium/helium-program-library"
  },
  "main": "./lib/cjs/index.js",
  "module": "./lib/esm/src/index.js",
  "types": "./lib/types/src/index.d.ts",
  "sideEffects": false,
  "files": [
    "lib"
  ],
  "exports": {
    "import": "./lib/esm/src/index.js",
    "require": "./lib/cjs/index.js",
    "types": "./lib/types/src/index.d.ts"
  },
  "scripts": {
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "precommit": "npx git-format-staged -f 'prettier --ignore-unknown --stdin --stdin-filepath \"{}\"' .",
    "clean": "npx shx mkdir -p lib && npx shx rm -rf lib",
    "package": "npx shx mkdir -p lib/cjs lib/esm",
    "prebuild": "npm run clean && npm run package",
    "build": "tsc -b tsconfig.json",
    "test": "mocha -r @swc-node/register \"tests/**/*.test.ts\" --timeout 10000"
  },
  "dependencies": {
    "@anchor-lang/core": "^0.31.2",
    "@helium/account-fetch-cache": "workspace:^",
    "@helium/account-fetch-cache-hooks": "workspace:^",
    "@helium/helium-react-hooks": "workspace:^",
    "@helium/hpl-crons-sdk": "workspace:^",
    "@helium/idls": "workspace:^",
    "@helium/lazy-distributor-sdk": "workspace:^",
    "@helium/spl-utils": "workspace:^",
    "@helium/tuktuk-sdk": "^0.1.1",
    "@solana/wallet-adapter-base": "^0.9.22",
    "@solana/web3.js": "^1.91.1",
    "axios": "^1.9.0",
    "bs58": "^4.0.1",
    "react-async-hook": "^4.0.0"
  },
  "devDependencies": {
    "@swc-node/register": "^1.11.1",
    "@swc/core": "^1.13.5",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "chai": "^6.2.0",
    "git-format-staged": "^2.1.3",
    "mocha": "^11.7.5",
    "ts-loader": "^9.2.3",
    "typescript": "^5.2.2"
  },
  "peerDependencies": {
    "@solana/wallet-adapter-react": "^0.15.32",
    "react": "^16.8 || ^17 || ^18",
    "react-dom": "^16.8 || ^17 || ^18"
  },
  "keywords": [],
  "author": "",
  "gitHead": "fc5dab2875863281ec468cf4a5a416c9696d102f"
}
